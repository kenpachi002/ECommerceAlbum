# Copy this file to .env and fill in values privately.
# Optional local database for development.
LOCAL_DATABASE_URL=
# Hosted PostgreSQL database. Leave blank for local-only use.
DATABASE_URL=
PORT=4000
JWT_SECRET=
RESEND_API_KEY=
# Optional sender, e.g. "Groove & Co. <support@your-verified-domain.com>"
RESEND_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173
